# ============================================================
# .env 模板文件（可以提交到 Git）
# 用法：复制本文件改名为 .env，再填入真实值；真正的 .env 不进 Git
# ============================================================

# ---------- 一、API 配置 ----------
# 接口文档标题
API_TITLE=智能预约系统 API
# 接口统一前缀
API_PREFIX=/api/v1
# 第三方接口 Key，没有就留空
THIRD_PARTY_API_KEY=

# ---------- 二、JWT 登录令牌配置 ----------
# 签名密钥：复制成 .env 后用下面命令生成随机值替换，不要直接用这行占位文字
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=请替换成随机字符串
# JWT 签名算法
ALGORITHM=HS256
# 访问令牌有效期（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=60
# 刷新令牌有效期（天）
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- 三、数据库连接 ----------
# 把「你的密码」换成实际值，密码不要带空格或 # 号；库名默认是 lab-agent
DATABASE_URL=mysql+pymysql://root:你的密码@127.0.0.1:3306/lab-agent?charset=utf8mb4

# ---------- 五、AI 助手（大模型）配置 ----------
# 大模型 API Key：填 DeepSeek（https://platform.deepseek.com）申请的 sk- 开头密钥；没有就留空，留空时 AI 接口返回「AI 服务未配置」
LM_API_KEY=
# 大模型接口地址（DeepSeek 兼容 OpenAI 规范）
LM_BASE_URL=https://api.deepseek.com
# 模型名
LM_MODEL=deepseek-chat
